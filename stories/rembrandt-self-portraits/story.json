 "facts": [
  {
   "claim": "About 80 self-portraits survive from Rembrandt's 40-year career; Self Portrait at the Age of 63 (1669, National Gallery, London) is one of three he made just before his death",
   "source": "https://www.nationalgallery.org.uk/paintings/rembrandt-self-portrait-at-the-age-of-63 ; https://en.wikipedia.org/wiki/Self-Portrait_at_the_Age_of_63"
  },
  {
   "claim": "Self-portrait, c. 1628 (Rijksmuseum): light along his right cheek, the rest of his face veiled in shadow; born July 1606, so about 22",
   "source": "https://www.rijksmuseum.nl/en/collection/SK-A-4691 ; https://en.wikipedia.org/wiki/Self-portraits_by_Rembrandt"
  },
  {
   "claim": "Self Portrait at the Age of 34 (1640, National Gallery): at the height of his fame, in the clothes of a gentleman of the 1520s, his pose based on Titian and Raphael",
   "source": "https://www.nationalgallery.org.uk/paintings/rembrandt-self-portrait-at-the-age-of-34 ; https://colourlex.com/project/rembrandt-self-portrait-at-the-age-of-34"
  },
  {
   "claim": "His wife Saskia died in 1642",
   "source": "https://www.nga.gov/collection/artist-info.1822.html ; https://www.theleidencollection.com/artists/rembrandt-van-rijn"
  },
  {
   "claim": "Debts piling up by 1652 (Large Self-Portrait, Kunsthistorisches Museum, Vienna): he stopped paying the mortgage on his house from 1649",
   "source": "https://assets.cambridge.org/052185/8259/excerpt/0521858259_excerpt.htm ; https://www.britannica.com/biography/Rembrandt-van-Rijn/Rembrandts-late-style"
  },
  {
   "claim": "Insolvent in 1656 (cessio bonorum); his art collection was auctioned in 1657 and 1658 and his house sold at a foreclosure auction by February 1658",
   "source": "https://www.nga.gov/collection/artist-info.1822.html ; https://en.wikipedia.org/wiki/Titus_van_Rijn"
  },
  {
   "claim": "Self-Portrait, 1658 (Frick Collection), painted at the time of his bankruptcy, in rich, historical costume, seated 'like an aged prince on a throne' (Holmes)",
   "source": "https://frick.org/sites/default/files/archivedsite/exhibitions/rembrandt/self_1658.htm ; https://transcribe.frick.org/wiki/.NTU3Mw.MzYxMg"
