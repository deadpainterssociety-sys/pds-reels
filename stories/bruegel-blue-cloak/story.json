 "facts": [
  {
   "claim": "Netherlandish Proverbs (also The Dutch Proverbs), oil on oak panel, 1559, by Pieter Bruegel the Elder; Gemäldegalerie, Staatliche Museen zu Berlin (acquired 1914 from an English collection)",
   "source": "https://en.wikipedia.org/wiki/Netherlandish_Proverbs ; https://artsandculture.google.com/asset/proverbs-pieter-bruegel-the-elder/CwGkTFwDGMmq9w ; https://projects.mcah.columbia.edu/bruegel2/htm/main"
  },
  {
   "claim": "Villagers literally act out proverbs and sayings; counts differ: 'more than 120' (Kemperdick, Gemäldegalerie), about 126 (Wikipedia), 'more than 100' (Google Arts & Culture), 'perhaps more than 90' (Columbia) — narrated as 'by most counts, more than a hundred'",
   "source": "https://artsandculture.google.com/story/hAWBUsSHOXLXIQ ; https://en.wikipedia.org/wiki/Netherlandish_Proverbs ; https://projects.mcah.columbia.edu/bruegel2/htm/main"
  },
  {
   "claim": "A man 'hitting his head against a wall' = wasting time on an impossible task",
   "source": "https://artsandculture.google.com/story/hAWBUsSHOXLXIQ ; https://en.wikipedia.org/wiki/Netherlandish_Proverbs (no. 004)"
  },
  {
   "claim": "A woman ties the devil to a pillow = 'to be able to tie even the devil to a pillow': obstinacy overcomes everything",
   "source": "https://artsandculture.google.com/story/hAWBUsSHOXLXIQ ; https://en.wikipedia.org/wiki/Netherlandish_Proverbs (no. 001)"
  },
  {
   "claim": "'One shears sheep, the other pigs': one has all the advantages, the other none (Kemperdick: some live in luxury, others are in need)",
   "source": "https://artsandculture.google.com/story/hAWBUsSHOXLXIQ ; https://en.wikipedia.org/wiki/Netherlandish_Proverbs (no. 010)"
  },
  {
   "claim": "Casting roses before swine = wasting effort on the unworthy",
   "source": "https://artsandculture.google.com/story/hAWBUsSHOXLXIQ ; https://en.wikipedia.org/wiki/Netherlandish_Proverbs (no. 106)"
  },
  {
   "claim": "The roof tiled with tarts: a land of plenty or a fool's paradise (Kemperdick); 'to be very wealthy' (Wikipedia)",
   "source": "https://artsandculture.google.com/story/hAWBUsSHOXLXIQ ; https://en.wikipedia.org/wiki/Netherlandish_Proverbs (no. 035)"
  },
  {
   "claim": "The inverted globe with its cross pointing down: the world turned upside down",
   "source": "https://en.wikipedia.org/wiki/Netherlandish_Proverbs (no. 024) ; https://artsandculture.google.com/asset/proverbs-pieter-bruegel-the-elder/CwGkTFwDGMmq9w"
  },
  {
   "claim": "A monk ties a flaxen (false) beard on the enthroned figure of God/Christ = hiding deceit under piety",
   "source": "https://artsandculture.google.com/story/hAWBUsSHOXLXIQ ; https://en.wikipedia.org/wiki/Netherlandish_Proverbs (no. 104)"
  },
  {
   "claim": "At the centre a wife puts a blue cloak on her husband, meaning she is cuckolding (deceiving) him; the blue cloak was a familiar symbol of deceit",
   "source": "https://en.wikipedia.org/wiki/Netherlandish_Proverbs ; https://en.wikipedia.org/wiki/The_Blue_Cloak ; https://artsandculture.google.com/asset/proverbs-pieter-bruegel-the-elder/CwGkTFwDGMmq9w"
  },
  {
   "claim": "The painting's early/original title: 'The Blue Cloak or The Folly of the World' (Wikipedia: 'original title'; Columbia: 'sometimes called the Blue Cloak') — narrated as 'once called'",
   "source": "https://en.wikipedia.org/wiki/Netherlandish_Proverbs ; https://projects.mcah.columbia.edu/bruegel2/htm/main ; https://artsandculture.google.com/asset/proverbs-pieter-bruegel-the-elder/CwGkTFwDGMmq9w"
  },
  {
   "claim": "His son Pieter Brueghel the Younger painted at least 16 copies",
   "source": "https://en.wikipedia.org/wiki/Netherlandish_Proverbs ; https://en.wikipedia.org/wiki/Pieter_Brueghel_the_Younger"
  }
 ],
