 "facts": [
  {
   "claim": "Velázquez painted the Portrait of Innocent X c. 1650 in Rome, during his second trip to Italy (1649–1651); the Pamphilj family kept it and it hangs in the Galleria Doria Pamphilj, Rome",
   "source": "https://en.wikipedia.org/wiki/Portrait_of_Innocent_X ; https://www.doriapamphilj.it/en/"
  },
  {
   "claim": "Olimpia Maidalchini was the widow of Pamphilio Pamphili, elder brother of Giambattista Pamphili (Innocent X, pope 1644–1655)",
   "source": "https://en.wikipedia.org/wiki/Olimpia_Maidalchini ; https://en.wikipedia.org/wiki/Pope_Innocent_X"
  },
  {
   "claim": "A Venetian ambassador wrote in 1645 that she 'has great influence with him'; a 1652 account (Giustiniani) said that when court offices fell vacant 'nothing was decided without her good pleasure' (narrated as a paraphrase, no quote marks)",
   "source": "https://en.wikipedia.org/wiki/Olimpia_Maidalchini (citing von Ranke, History of the Popes, and Williams 2004, p. 110) ; https://www.encyclopedia.com/religion/encyclopedias-almanacs-transcripts-and-maps/innocent-x-pope ('had great influence with the aged Pontiff')"
  },
  {
   "claim": "She was nicknamed the 'papessa' (lady pope)",
   "source": "https://en.wikipedia.org/wiki/Olimpia_Maidalchini (citing León, Uppity Women of the Renaissance) ; https://www.sothebys.com/en/articles/mistress-of-the-vatican-donna-olimpia-maidalchini-pamphilj"
  },
  {
   "claim": "Velázquez also painted Olimpia (c. 1650); the portrait was last documented in 1724 and resurfaced in 2019, sold at Sotheby's London on 3 July 2019 for £2.5 million ('almost three hundred years' = 1724 to 2019)",
   "source": "https://www.antiquestradegazette.com/news/2019/rediscovered-velázquez-portrait-of-one-of-the-17th-century-s-most-powerful-women-comes-to-auction-at-sotheby-s/ ; https://news.artnet.com/art-world/velazquez-sothebys-old-masters-sale-2019-1592767"
  },
  {
   "claim": "Legend (narrated as 'supposedly'): when Innocent X died (night of 6–7 January 1655) she refused to pay for his coffin/funeral, pleading she was a poor widow, and his body was abandoned for three days",
   "source": "https://en.wikipedia.org/wiki/Olimpia_Maidalchini (Leti; Ranke via Williams; Pastor) ; https://www.csun.edu/~hcfll004/SV1655.html (quotes the claim 'the body of the pope was completely abandoned for three days', derived in part from Gregorio Leti)"
  },
  {
   "claim": "The papal ceremony diaries (Servantio) record the body dressed in vestments, taken to the Vatican and laid on a catafalque with the Office for the Dead; on 8 January it was moved to St Peter's, where cardinals witnessed the sealing of the coffin; the historian J. P. Adams calls the abandonment story 'ridiculous'",
   "source": "https://www.csun.edu/~hcfll004/SV1655.html ; https://en.wikipedia.org/wiki/Pope_Innocent_X"
  },
  {
   "claim": "Her influence was real (contemporary ambassadors' reports); the abandonment story is probably false (narrated with 'probably')",
   "source": "https://en.wikipedia.org/wiki/Olimpia_Maidalchini ; https://www.csun.edu/~hcfll004/SV1655.html"
  },
  {
   "claim": "Hangs in the Galleria Doria Pamphilj, Rome",
   "source": "https://en.wikipedia.org/wiki/Portrait_of_Innocent_X ; https://www.doriapamphilj.it/en/"
  }
 ],
