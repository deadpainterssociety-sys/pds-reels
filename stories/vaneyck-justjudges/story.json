 "facts": [
  {
   "claim": "The Just Judges panel in the altarpiece today is a copy; the original was stolen in 1934 and has never been found",
   "source": "https://en.wikipedia.org/wiki/The_Just_Judges ; https://www.brusselstimes.com/49026/missing-van-eyck-panel-in-a-tunnel-under-ghent-the-end-of-belgium-s-biggest-mystery ; https://www.vrt.be/vrtnws/en/2024/04/10/the-mystery-of-the-disappearance-of-the-just-judges-90-years-on/"
  },
  {
   "claim": "The Ghent Altarpiece is attributed to the brothers Hubert and Jan van Eyck; Jan completed it in 1432",
   "source": "https://en.wikipedia.org/wiki/Ghent_Altarpiece"
  },
  {
   "claim": "Stolen on the night of 10 (to 11) April 1934 from St Bavo's Cathedral, Ghent: the lower left panel (Just Judges, with St John the Baptist on its reverse)",
   "source": "https://en.wikipedia.org/wiki/The_Just_Judges ; https://www.vrt.be/vrtnws/en/2024/04/10/the-mystery-of-the-disappearance-of-the-just-judges-90-years-on/ ; https://commons.wikimedia.org/wiki/File:Rechtvaardige_rechters_parket_oproep.jpg (1934 police notice: 'la nuit du 10 au 11 avril 1934 … le panneau gauche')"
  },
  {
   "claim": "The Bishop of Ghent received a ransom demand of one million Belgian francs",
   "source": "https://en.wikipedia.org/wiki/The_Just_Judges (citing Charney, Stealing the Mystic Lamb, 2010) ; https://www.futilitycloset.com/category/crime/page/18"
  },
  {
   "claim": "As proof, the ransomer returned the St John the Baptist part, found in a luggage locker at Brussels North station",
   "source": "https://www.vrt.be/vrtnws/en/2024/04/10/the-mystery-of-the-disappearance-of-the-just-judges-90-years-on/ ; https://en.wikipedia.org/wiki/The_Just_Judges"
  },
  {
   "claim": "The government refused to pay",
   "source": "https://en.wikipedia.org/wiki/The_Just_Judges (citing Charney 2010)"
  },
  {
   "claim": "In late November 1934 Arsène Goedertier (a broker, 1876–1934) collapsed after a speech at a political meeting; dying, he told his lawyer Georges de Vos that he alone knew where the panel was; he died 25 November 1934",
   "source": "https://en.wikipedia.org/wiki/The_Just_Judges (citing Charney 2010; Guardian 2013) ; https://www.futilitycloset.com/category/crime/page/18"
  },
  {
   "claim": "His lawyer found carbon copies of the ransom letters among his papers, but no panel",
   "source": "https://en.wikipedia.org/wiki/The_Just_Judges ; https://www.futilitycloset.com/category/crime/page/18"
  },
  {
   "claim": "Jef Van der Veken painted a replacement copy in 1945 and gave one of the judges the features of King Leopold III",
   "source": "https://en.wikipedia.org/wiki/The_Just_Judges (citing Schrever, Historiek, 2010)"
  },
  {
   "claim": "Whether the original still exists is unknown (some believe it destroyed); the altarpiece is displayed in St Bavo's Cathedral, Ghent",
   "source": "https://en.wikipedia.org/wiki/The_Just_Judges ; https://en.wikipedia.org/wiki/Ghent_Altarpiece"
  }
 ],
 "caption": "On the night of 10 April 1934, a thief walked out of St Bavo's Cathedral in Ghent with the lower left panel of the Ghent Altarpiece, the van Eyck brothers' masterpiece finished in 1432. The panel showed the Just Judges on horseback, with St John the Baptist painted on its back.\n\nThe Bishop of Ghent then received a ransom demand: one million Belgian francs. To prove he had it, the thief returned St John the Baptist, left in a luggage locker at Brussels North station. Belgium refused to pay.\n\nThat November, a broker named Arsène Goedertier collapsed after a political speech. Dying, he told his lawyer that he alone knew where the panel was. In his papers: carbon copies of the ransom letters. But no panel.\n\nIn 1945 the restorer Jef Van der Veken painted a copy to fill the gap, and gave one judge the face of King Leopold III. The real Just Judges have never been found.\n\n🖤 Where do you think it is?",
 "caption_short": "These judges are a copy. The real panel was stolen in 1934 and never found. 🖤",
 "youtube_title": "Where are the real judges? | Van Eyck, Ghent Altarpiece",
