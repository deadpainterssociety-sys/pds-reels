 "facts": [
  {
   "claim": "Goya (1746–1828) painted The Duke of Wellington in Madrid, probably shortly after Wellington's arrival in August 1812; altered c. 1814",
   "source": "https://www.nationalgallery.org.uk/paintings/francisco-de-goya-the-duke-of-wellington ; https://en.wikipedia.org/wiki/Portrait_of_the_Duke_of_Wellington_(Goya)"
  },
  {
   "claim": "1961: bought at Sotheby's by American collector Charles Wrightsman for £140,000; the National Gallery acquired it for £140,000 with the Wolfson Foundation (£100,000) and a special Exchequer grant to keep it in Britain",
   "source": "https://www.wolfson.org.uk/goya-wellington-stolen-portrait/ ; https://en.wikipedia.org/wiki/Portrait_of_the_Duke_of_Wellington_(Goya) ; https://www.nationalgallery.org.uk/paintings/francisco-de-goya-the-duke-of-wellington"
  },
  {
   "claim": "Stolen from the National Gallery on 21 August 1961, less than three weeks after it went on display (2 or 3 August 1961)",
   "source": "https://www.nationalgallery.org.uk/research/research-centre/archive/record/NGA26 ; https://www.wolfson.org.uk/goya-wellington-stolen-portrait/ ; https://artreview.com/national-gallery-goya-theft-kempton-bunton/"
  },
  {
   "claim": "Ransom notes demanded £140,000 be given to charity to pay for TV licences for poor pensioners",
   "source": "https://www.nationalgallery.org.uk/research/research-centre/archive/record/NGA26 ; https://www.wolfson.org.uk/goya-wellington-stolen-portrait/"
  },
  {
   "claim": "Returned in May 1965 (almost four years later) via the left-luggage office at Birmingham New Street station, after a ticket was sent to the Daily Mirror",
   "source": "https://www.wolfson.org.uk/goya-wellington-stolen-portrait/ ; https://en.wikipedia.org/wiki/Kempton_Bunton"
  },
  {
   "claim": "Kempton Bunton (born 14 June 1904, Newcastle upon Tyne), a retired driver aged 61, surrendered on 19 July 1965",
   "source": "https://www.nationalgallery.org.uk/research/research-centre/archive/record/NGA26 ; https://en.wikipedia.org/wiki/Kempton_Bunton ; https://artreview.com/national-gallery-goya-theft-kempton-bunton/"
  },
  {
   "claim": "At the Old Bailey (November 1965) he was cleared of stealing the painting but convicted of stealing the frame, which was never returned; three months in prison",
   "source": "https://www.nationalgallery.org.uk/research/research-centre/archive/record/NGA26 ; https://en.wikipedia.org/wiki/Kempton_Bunton"
  },
  {
   "claim": "Files released in 2012 showed his son John Bunton confessed in 1969 to being the thief; no prosecution followed",
   "source": "https://www.theguardian.com/artanddesign/2012/nov/30/1961-goya-crime-national-gallery ; https://en.wikipedia.org/wiki/Kempton_Bunton ; https://www.nationalgallery.org.uk/research/research-centre/archive/record/NGA26"
  },
  {
   "claim": "P.S.: a copy of the portrait appears in Dr No's lair in the 1962 Bond film Dr. No",
   "source": "https://en.wikipedia.org/wiki/Portrait_of_the_Duke_of_Wellington_(Goya) ; https://www.wolfson.org.uk/goya-wellington-stolen-portrait/"
  },
  {
   "claim": "Hangs in the National Gallery, London (NG6322)",
   "source": "https://www.nationalgallery.org.uk/paintings/francisco-de-goya-the-duke-of-wellington"
  }
 ],
 "caption": "This Goya was stolen to pay for TV licences.\n\nGoya painted the Duke of Wellington in Madrid in 1812. In 1961 the National Gallery paid £140,000 to keep it from going to an American collector, and on 21 August 1961, less than three weeks after it went on show, it vanished.\n\nRansom notes followed: the thief wanted £140,000 given to charity to buy TV licences for poor pensioners. For almost four years nobody found it. In May 1965 it turned up in the left-luggage office at Birmingham New Street station. That July, Kempton Bunton, a 61-year-old retired driver from Newcastle, turned himself in.\n\nThe jury cleared him of stealing the painting. He got three months for the frame, which was never returned. Then in 2012, released files showed that his son John had confessed in 1969 to being the real thief.\n\nP.S. While it was missing, a copy turned up in Dr No's lair in the first James Bond film.\n\n🖤 Would you have convicted him?",
 "caption_short": "Stolen in 1961 to pay pensioners' TV licences. The thief was jailed for the frame, not the Goya. Or was he even the thief? 🖤",
 "youtube_title": "Who stole the Duke? Goya's Duke of Wellington heist",
