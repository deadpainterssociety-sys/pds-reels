 "facts": [
  {
   "claim": "The Parasol (c. 1777, Prado) is a cartoon painted for a tapestry for the dining room of the Prince and Princess of Asturias at the royal palace of El Pardo",
   "source": "https://en.wikipedia.org/wiki/The_Parasol ; https://en.wikipedia.org/wiki/Francisco_Goya"
  },
  {
   "claim": "Between late 1792 and early 1793 an undiagnosed illness left Goya (born 30 March 1746) deaf, aged about 46",
   "source": "https://en.wikipedia.org/wiki/Francisco_Goya ; https://blog.oup.com/2016/04/francisco-goya-deafness/"
  },
  {
   "claim": "Yard with Lunatics (c. 1794, Meadows Museum, Dallas): in a 1794 letter to Bernardo de Iriarte Goya called it 'a scene I witnessed at Zaragoza'",
   "source": "https://en.wikipedia.org/wiki/Yard_with_Lunatics ; https://medhum.med.nyu.edu/view/10318"
  },
  {
   "claim": "The Third of May 1808 (painted 1814, Prado) shows French soldiers executing Spaniards in the early hours after the 2 May uprising",
   "source": "https://en.wikipedia.org/wiki/The_Third_of_May_1808"
  },
  {
   "claim": "The Black Paintings (c. 1819/1820–1823), including Witches' Sabbath and The Dog, were painted in oil directly on the plaster walls of his house, the Quinta del Sordo, when Goya was in his seventies (about 75); now in the Prado",
   "source": "https://en.wikipedia.org/wiki/Witches%27_Sabbath_(The_Great_He-Goat) ; https://en.wikipedia.org/wiki/The_Dog_(Goya) ; https://en.wikipedia.org/wiki/Francisco_Goya"
  },
  {
