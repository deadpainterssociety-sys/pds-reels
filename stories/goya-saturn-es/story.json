 "facts": [
  {
   "claim": "Goya bought the Quinta del Sordo in February 1819, aged 72",
   "source": "https://en.wikipedia.org/wiki/Black_Paintings"
  },
  {
   "claim": "Goya had been deaf since an illness in 1792–93",
   "source": "https://en.wikipedia.org/wiki/Francisco_Goya"
  },
  {
   "claim": "The house was already named after a previous owner who was deaf",
   "source": "https://en.wikipedia.org/wiki/Black_Paintings"
  },
  {
   "claim": "Acute, dangerous illness at the end of 1819; Dr Arrieta saved his life",
   "source": "https://en.wikipedia.org/wiki/Self-Portrait_with_Dr_Arrieta (inscription on the 1820 painting)"
  },
  {
   "claim": "14 murals, oil on plaster, c. 1820–1823; Goya never revealed titles; likely never intended for public exhibition",
   "source": "https://en.wikipedia.org/wiki/Black_Paintings ; https://fundaciongoyaenaragon.es/eng/obra/saturno-devorando-a-un-hijo/660"
  },
  {
   "claim": "Saturn was on the ground floor; historians (Glendinning) take that room to be the dining room",
   "source": "https://en.wikipedia.org/wiki/Saturn_Devouring_His_Son ; https://es.hispanopedia.com/wiki/Pinturas_negras"
  },
  {
   "claim": "Myth: Saturn ate his children so none would overthrow him",
   "source": "https://en.wikipedia.org/wiki/Saturn_Devouring_His_Son"
  },
  {
   "claim": "Goya left for Bordeaux in 1824 and died there in 1828",
   "source": "https://en.wikipedia.org/wiki/Francisco_Goya"
  },
  {
   "claim": "Baron Émile d'Erlanger (banker) bought the house in 1873 and had the murals transferred to canvas from 1874 (Salvador Martínez Cubells)",
