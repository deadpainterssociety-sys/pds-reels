 "facts": [
  {
   "claim": "The severed head of Goliath is traditionally identified as Caravaggio's self-portrait (recorded by Manilli and by Bellori, 1672); the museum calls it his self-portrait",
   "source": "https://www.collezionegalleriaborghese.it/en/opere/david-with-the-head-of-goliath ; https://en.wikipedia.org/wiki/David_with_the_Head_of_Goliath_(Caravaggio,_Rome)"
  },
  {
   "claim": "On 28 May 1606, in Rome, Caravaggio killed Ranuccio Tomassoni in a brawl/duel (sources vary: 28 or 29 May; circumstances disputed)",
   "source": "https://en.wikipedia.org/wiki/Exile_of_Caravaggio ; https://en.wikipedia.org/wiki/Caravaggio"
  },
  {
   "claim": "He was sentenced to death (bando capitale): a death sentence enforceable by anyone, anywhere; anyone who recognised him could carry out the sentence legally",
   "source": "https://en.wikipedia.org/wiki/Exile_of_Caravaggio ; https://en.wikipedia.org/wiki/Caravaggio"
  },
  {
   "claim": "He fled Rome to Naples, Malta and Sicily (1606–1610); in exile his paintings began to depict severed heads, often his own",
   "source": "https://en.wikipedia.org/wiki/Caravaggio ; https://en.wikipedia.org/wiki/Exile_of_Caravaggio"
  },
  {
   "claim": "The sword bears the letters 'H-AS OS', read by many critics as the Augustinian motto humilitas occidit superbiam, 'humility kills pride' (other readings: a signature, a maker's mark)",
   "source": "https://www.collezionegalleriaborghese.it/en/opere/david-with-the-head-of-goliath ; https://en.wikipedia.org/wiki/David_with_the_Head_of_Goliath_(Caravaggio,_Rome)"
  },
  {
   "claim": "Scholars (Calvesi) think it was a pledge/gift to Cardinal Scipione Borghese, the pope's nephew, who had the power to grant a pardon; it was in Borghese's collection by 1613 — a theory, hedged in the narration",
   "source": "https://www.collezionegalleriaborghese.it/en/opere/david-with-the-head-of-goliath ; https://en.wikipedia.org/wiki/David_with_the_Head_of_Goliath_(Caravaggio,_Rome)"
  },
  {
   "claim": "In summer 1610 he sailed north from Naples toward Rome to receive a pardon that seemed imminent, carrying paintings possibly meant for Scipione Borghese; he died on the way, at Porto Ercole, on 18 July 1610, aged 38",
   "source": "https://en.wikipedia.org/wiki/Caravaggio ; https://en.wikipedia.org/wiki/Exile_of_Caravaggio"
  },
  {
   "claim": "Dated 1606–07 or 1609–1610 (most critics: second Neapolitan stay); 125 x 101 cm; bought by the Italian state in 1902; hangs in the Galleria Borghese, Rome",
   "source": "https://www.collezionegalleriaborghese.it/en/opere/david-with-the-head-of-goliath"
  }
 ],
