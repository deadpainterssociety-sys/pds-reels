 "facts": [
  {
   "claim": "Monet's Japanese footbridge over the water-lily pond in his garden at Giverny, painted in 1899 (The Japanese Footbridge, National Gallery of Art, Washington; The Water-Lily Pond, National Gallery, London)",
   "source": "https://www.nga.gov/artworks/74796-japanese-footbridge.html ; https://pmc.ncbi.nlm.nih.gov/articles/PMC4408507/"
  },
  {
   "claim": "In his 60s Monet developed bilateral age-related cataracts; in 1913 he consulted the ophthalmologist Richard Liebreich in London, who recommended surgery on the right eye, and Monet refused",
   "source": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4408507/ ; https://en.wikipedia.org/wiki/Claude_Monet"
  },
  {
   "claim": "By 1918 he recognised that he no longer perceived colours with the same intensity; Monet: 'colours no longer had the same intensity for me', 'reds had begun to look muddy'",
   "source": "https://eclecticlight.co/2026/11/06/painting-with-impaired-vision-claude-monet/ ; https://pmc.ncbi.nlm.nih.gov/articles/PMC4408507/ ; https://theophthalmologist.com/issues/2024/articles/jun/the-cataracts-of-claude-monet"
  },
  {
   "claim": "To avoid choosing the wrong colours he began to label his tubes of paint",
   "source": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4408507/ ; https://en.wikipedia.org/wiki/Claude_Monet"
  },
  {
   "claim": "Le Pont japonais, 1918 (Musée Marmottan Monet, Paris, W 1913) and The Japanese Footbridge, c. 1920–22 (MoMA, New York), among his last paintings of the subject",
   "source": "https://www.moma.org/collection/works/79254 ; https://commons.wikimedia.org/wiki/File:Claude_Monet_-_Le_Pont_japonais_W1913_-_Mus%C3%A9e_Marmottan-Monet.jpg"
  },
  {
   "claim": "In 1922 the ophthalmologist Charles Coutela recorded light perception only in Monet's right eye",
   "source": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4408507/"
  },
  {
   "claim": "The Japanese Footbridge, Giverny, c. 1922, Museum of Fine Arts, Houston (John A. and Audrey Jones Beck Collection, 76.198)",
   "source": "https://emuseum.mfah.org/objects/3511/the-japanese-footbridge-giverny ; https://commons.wikimedia.org/wiki/File:Claude_Monet_-_The_Japanese_Footbridge_(Museum_of_Fine_Arts,_Houston).jpg"
  },
  {
   "claim": "Surgery on his right eye was carried out in early 1923 (January 1923, a two-stage operation)",
   "source": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4408507/ ; https://eclecticlight.co/2026/11/06/painting-with-impaired-vision-claude-monet/"
  },
  {
   "claim": "After surgery, now able to see the 'real' colours of his works, he began to destroy canvases from his pre-operative period",
   "source": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4408507/ ; https://en.wikipedia.org/wiki/Claude_Monet ; https://theophthalmologist.com/issues/2024/articles/jun/the-cataracts-of-claude-monet"
  },
  {
   "claim": "Monet died in December 1926",
   "source": "https://en.wikipedia.org/wiki/Claude_Monet"
  }
 ],
 "caption": "Put Monet's paintings of his Japanese footbridge in order and you can watch his eyesight fail.\n\n1899: his water garden at Giverny, cool greens, every leaf sharp (National Gallery of Art, Washington; National Gallery, London). In 1913 cataracts are clouding both his eyes; a London eye doctor, Richard Liebreich, urges surgery. Monet refuses. By 1918 colours no longer have the same intensity for him, and reds look muddy. He starts labelling his tubes of paint so he won't pick the wrong colour. In 1922 his right eye perceives only light. He keeps painting: this burning, almost abstract bridge dates from about then.\n\nIn early 1923 surgeons operate on his right eye. Now he can see the real colours of what he painted half-blind, and he begins to destroy canvases from those years. This one survived.\n\n🖤 Would you have destroyed it?",
 "caption_short": "Watch Monet's bridge as his eyes fail. After surgery he saw what he'd painted, and destroyed canvases. 🖤",
 "youtube_title": "Why did Monet destroy them? Monet's Japanese Footbridge, 1899–1922",
