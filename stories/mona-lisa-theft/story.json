 "facts": [
  {
   "claim": "Stolen 21 August 1911 (a Monday, museum closed) in the early morning",
   "source": "https://www.historyhit.com/culture/theft-mona-lisa/ ; https://europeana.eu/en/blog/did-picasso-steal-the-mona-lisa ; https://www.npr.org/2011/07/30/138800110/the-theft-that-made-the-mona-lisa-a-masterpiece"
  },
  {
   "claim": "Before the theft it 'wasn't even the most famous painting in its gallery' (Zug, NPR)",
   "source": "https://www.npr.org/2011/07/30/138800110/the-theft-that-made-the-mona-lisa-a-masterpiece"
  },
  {
   "claim": "Vincenzo Peruggia, a handyman who had installed the protective glass cases; dressed in the white smock worn by employees",
   "source": "NPR ; History Hit"
  },
  {
   "claim": "Removed it from its frame and hid it under his clothes; walked out",
   "source": "History Hit ; https://history.com/this-day-in-history/theft-of-mona-lisa-is-discovered"
  },
  {
   "claim": "28 hours before anyone noticed the four bare hooks; a painter (Louis Béroud) asked; guards assumed it was being photographed",
   "source": "NPR ; History Hit"
  },
  {
   "claim": "Louvre closed for a week; Apollinaire arrested; Picasso suspected and questioned before the judge",
   "source": "NPR ; History Hit ; Europeana"
  },
  {
   "claim": "Crowds queued to see the empty space (Kafka among them)",
   "source": "History Hit ; NPR"
  },
  {
   "claim": "Missing 28 months; Dec 1913 Peruggia tried to sell it to Florence dealer Alfredo Geri, who brought in Uffizi director Giovanni Poggi; arrested that day",
   "source": "History Hit ; NPR"
  },
  {
   "claim": "Claimed patriotic motive (return it to Italy); served seven months of a one-year sentence",
   "source": "History.com ; History Hit"
  },
  {
   "claim": "Returned to the Louvre 4 January 1914; the theft made it one of the most famous artworks in the world",
   "source": "History Hit ; NPR"
  }
 ],
 "caption": "One morning in 1911, a man walked out of the Louvre with the Mona Lisa under his smock.\n\nVincenzo Peruggia had worked at the museum and had helped install her protective glass case. Nobody noticed for 28 hours: the guards assumed she was being photographed. The Louvre closed for a week, Apollinaire was arrested, Picasso was questioned, and crowds queued to stare at the empty wall.\n\nTwo years later Peruggia tried to sell her to a dealer in Florence, who called in the Uffizi's director. He was arrested that day.\n\nBefore the theft she wasn't even the most famous painting in her room. She came back the most famous painting in the world.\n\n🖤 Would you have noticed she was gone?",
 "caption_short": "1911: a handyman walked out of the Louvre with the Mona Lisa under his smock. Nobody noticed for 28 hours. 🖤",
 "youtube_title": "Who walked out of the Louvre with the Mona Lisa?",
