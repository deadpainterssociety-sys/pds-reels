 "facts": [
  {
   "claim": "The painting shows Holy Roman Emperor Rudolf II, made of fruit, vegetables and flowers",
   "source": "https://en.wikipedia.org/wiki/Vertumnus_(painting) ; https://www.smithsonianmag.com/arts-culture/arcimboldos-feast-for-the-eyes-74732989/"
  },
  {
   "claim": "Rudolf II held court in Prague; his Kunstkammer collection was famous (later looted)",
   "source": "https://www.smithsonianmag.com/arts-culture/arcimboldos-feast-for-the-eyes-74732989/ ; https://www.habsburger.net/en/chapter/depicting-imperial-might-pictures-fruit"
  },
  {
   "claim": "Arcimboldo, Rudolf's former court painter, retired to Milan in 1587 and painted Vertumnus (c. 1590–91) as a gift to his former employer; presented in 1591",
   "source": "https://skoklostersslott.se/en/the-history-of-skokloster-castle/skokloster-castles-collections/vertumnus-en/ ; https://en.wikipedia.org/wiki/Giuseppe_Arcimboldo ; https://en.wikipedia.org/wiki/Vertumnus_(painting)"
  },
  {
   "claim": "The face: a pear nose, apple cheeks, cherry lips (plants listed include pears, apples, cherries, grapes, wheat, corn, gourds, onions)",
   "source": "https://en.wikipedia.org/wiki/Vertumnus_(painting) (and the painting itself)"
  },
  {
   "claim": "He is shown as Vertumnus, the Roman god of the seasons (and of gardens and plant growth)",
   "source": "https://en.wikipedia.org/wiki/Vertumnus_(painting) ; https://www.smithsonianmag.com/arts-culture/arcimboldos-feast-for-the-eyes-74732989/ ; https://www.habsburger.net/en/chapter/depicting-imperial-might-pictures-fruit"
  },
  {
   "claim": "Rudolf is said to have rewarded Arcimboldo for the painting with the title of count palatine (1592) — hedged: no contemporary account of his reaction",
   "source": "https://www.habsburger.net/en/chapter/depicting-imperial-might-pictures-fruit ; https://www.theartstory.org/artist/arcimboldo-giuseppe/life-and-legacy/"
  },
  {
   "claim": "In 1648 Swedish troops under Königsmarck took Prague (the castle and Lesser Town) and its art; the spoils went to Stockholm by cart caravan; item 351 on the transport list was 'a face of fruit'",
   "source": "https://skoklostersslott.se/en/the-history-of-skokloster-castle/skokloster-castles-collections/vertumnus-en/ ; https://www.smithsonianmag.com/arts-culture/arcimboldos-feast-for-the-eyes-74732989/"
  },
  {
   "claim": "It passed through Swedish collections (Per Brahe's Bogesund Castle) and was moved to Skokloster between 1828 and 1845; late-19th-century art historian Olof Granberg called the two Arcimboldos 'of inferior quality'",
   "source": "https://skoklostersslott.se/en/the-history-of-skokloster-castle/skokloster-castles-collections/vertumnus-en/"
  },
  {
   "claim": "Plants from all seasons appear together; the poems sent with it said the emperor 'holds sway over the seasons as he does over the countries of the world' (Comanini's poem accompanied the painting)",
   "source": "https://www.habsburger.net/en/chapter/depicting-imperial-might-pictures-fruit ; https://skoklostersslott.se/en/the-history-of-skokloster-castle/skokloster-castles-collections/vertumnus-en/ ; https://en.wikipedia.org/wiki/Vertumnus_(painting)"
  },
  {
   "claim": "It hangs in Skokloster Castle, Sweden",
   "source": "https://skoklostersslott.se/en/the-history-of-skokloster-castle/skokloster-castles-collections/vertumnus-en/"
  }
 ],
 "caption": "This is Rudolf II, Holy Roman Emperor. Made of fruit.\n\nAround 1591, his former court painter Giuseppe Arcimboldo, retired to Milan, sent him this portrait: a pear for a nose, apples for cheeks, cherries for lips, wheat and grapes for hair. He is dressed as Vertumnus, the Roman god of the seasons.\n\nThe emperor wasn't offended. He is said to have rewarded Arcimboldo with the title of count palatine.\n\nIn 1648, at the end of the Thirty Years' War, Swedish troops stormed Prague Castle and carted the treasures to Stockholm. On the transport list, item 351: \"a face of fruit\". It ended up in Swedish castles, and in the late 1800s an art historian dismissed it as of \"inferior quality\".\n\nBut look again: fruit, grain and flowers from every season, all ripe at once. The poem sent with it said the emperor ruled the seasons as he ruled the countries of the world.\n\n🖤 Would you hang this portrait of yourself?",
 "caption_short": "This is a Holy Roman Emperor. Made of fruit. And he is said to have rewarded the painter for it. 🖤",
 "youtube_title": "Why is this emperor fruit? Arcimboldo's Vertumnus (Rudolf II)",
