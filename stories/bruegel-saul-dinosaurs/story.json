 "facts": [
  {
   "claim": "Viral social-media posts claim the painting shows dinosaurs and proves humans lived alongside them ('300 years before we supposedly knew anything about dinosaurs')",
   "source": "https://www.iflscience.com/some-people-think-this-old-painting-proves-dinosaurs-walked-around-with-humans-72367 ; https://www.focus.it/cultura/curiosita/come-fanno-a-esserci-i-dinosauri-in-questo-dipinto-del-1500"
  },
  {
   "claim": "The Suicide of Saul, oil on panel, 33.5 x 55 cm, painted by Pieter Bruegel the Elder in 1562 (inscribed 'SAUL XXXI CAPIT BRVEGEL M.CCCCC.LXII')",
   "source": "https://en.wikipedia.org/wiki/The_Suicide_of_Saul ; https://www.khm.at/en/objectdb/detail/322/"
  },
  {
   "claim": "Richard Owen coined the name Dinosauria in 1842 (published April 1842)",
   "source": "https://en.wikipedia.org/wiki/Dinosaur ; https://en.wikipedia.org/wiki/Richard_Owen"
  },
  {
   "claim": "The long-necked animals are almost certainly / most likely camels, drawn crudely because the painter had no model to work from (hedged in narration: 'most likely', 'it seems'); Commons also titles the detail 'camels'",
   "source": "https://www.iflscience.com/some-people-think-this-old-painting-proves-dinosaurs-walked-around-with-humans-72367 ; https://www.focus.it/cultura/curiosita/come-fanno-a-esserci-i-dinosauri-in-questo-dipinto-del-1500 ; https://commons.wikimedia.org/wiki/File:Pieter_Bruegel_d._%C3%84._Selbstmord_Sauls_(camels).jpg"
  },
  {
   "claim": "The subject is King Saul's suicide after his defeat by the Philistines on Mount Gilboa; Saul is shown on the left of the picture",
   "source": "https://www.khm.at/en/objectdb/detail/322/ ; https://en.wikipedia.org/wiki/The_Suicide_of_Saul"
  },
  {
   "claim": "1 Samuel 31:4: Saul asked his armourbearer to thrust him through; the armourbearer would not, so Saul took a sword and fell upon it (the painting shows the armour-bearer too, pierced by his own sword, v. 5)",
   "source": "https://www.biblegateway.com/passage/?search=1+Samuel+31&version=KJV ; https://en.wikipedia.org/wiki/The_Suicide_of_Saul"
  },
  {
   "claim": "Inscription on a stone at the bottom: 'SAUL XXXI CAPIT' (Saul, chapter 31) and 'BRVEGEL M.CCCCC.LXII'",
   "source": "https://en.wikipedia.org/wiki/The_Suicide_of_Saul ; https://commons.wikimedia.org/wiki/File:The_Suicide_of_Saul,_1562.jpg (seen on the scan)"
  },
  {
   "claim": "Saul's death was read as a punishment for pride (Dante puts Saul among the proud in Purgatorio); the museum lists 'punished pride' among the readings and says the landscape is the main subject, the biblical story secondary",
   "source": "https://www.khm.at/en/objectdb/detail/322/ ; https://en.wikipedia.org/wiki/The_Suicide_of_Saul"
  },
  {
   "claim": "Hangs in the Kunsthistorisches Museum, Vienna (Picture Gallery); in the imperial collection by 1781",
   "source": "https://www.khm.at/en/objectdb/detail/322/ ; https://en.wikipedia.org/wiki/The_Suicide_of_Saul"
  }
