 "facts": [
  {
   "claim": "Painted 1647–51; Velázquez's only surviving female nude",
   "source": "https://www.nationalgallery.org.uk/paintings/diego-velazquez-the-toilet-of-venus-the-rokeby-venus"
  },
  {
   "claim": "Female nudes were extremely rare / forbidden in Inquisition-era Spain",
   "source": "https://news.artnet.com/art-world/diego-velazquez-rokeby-venus-facts-2069892 ; en.wikipedia.org/wiki/Rokeby_Venus"
  },
  {
   "claim": "Bought for the nation in 1906 after a public campaign by the National Art Collections Fund (£45,000)",
   "source": "https://www.nationalgallery.org.uk/paintings/diego-velazquez-the-toilet-of-venus-the-rokeby-venus ; https://theartnewspaper.com/2023/11/08/how-velazquezs-rokeby-venus-became-a-symbol-of-public-pride-and-then-political-protest"
  },
  {
   "claim": "10 March 1914: suffragette Mary Richardson attacked it with a meat cleaver (concealed up her sleeve)",
   "source": "https://artinsociety.com/from-the-rokeby-venus-to-fascism-pt-1-why-did-suffragettes-attack-artworks.html ; https://news.artnet.com/art-world/diego-velazquez-rokeby-venus-facts-2069892"
  },
  {
   "claim": "She carried a sketchbook to look inconspicuous",
   "source": "https://www.historytoday.com/miscellanies/deeds-not-words-slashing-rokeby-venus"
  },
  {
   "claim": "The attendant first took the breaking glass for a skylight, then slipped on the polished floor",
   "source": "https://artinsociety.com/from-the-rokeby-venus-to-fascism-pt-1-why-did-suffragettes-attack-artworks.html ; History Today (an attendant 'fell to the ground')"
  },
  {
   "claim": "Cuts on Venus's back (visible later as discolouration along her spine); number reported as 7 or 8, so not stated",
   "source": "History Today ; artnet ; The Art Newspaper"
  },
  {
   "claim": "Protest at the arrest of Emmeline Pankhurst the previous day; 'I have tried to destroy the picture of the most beautiful woman in mythological history as a protest against the Government for destroying Mrs Pankhurst'",
   "source": "artnet ; artinsociety"
  },
  {
   "claim": "Sentenced to six months, the maximum for the offence",
