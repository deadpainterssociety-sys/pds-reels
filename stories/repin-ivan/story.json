 "facts": [
  {
   "claim": "Ilya Repin (1844–1930) painted 'Ivan the Terrible and His Son Ivan on 16 November 1581' in 1883–1885; it shows Ivan IV holding his dying son after striking him",
   "source": "https://en.wikipedia.org/wiki/Ivan_the_Terrible_and_His_Son_Ivan ; https://www.tretyakovgallerymagazine.com/node/8318"
  },
  {
   "claim": "Historians debate the death; most accounts (Possevino) say the tsar struck his son with his staff",
   "source": "https://en.wikipedia.org/wiki/Ivan_the_Terrible_and_His_Son_Ivan ; https://www.rbth.com/arts/330317-ivan-terrible-and-his-son-painting"
  },
  {
   "claim": "Alexander III banned its exhibition in April 1885; the ban was lifted in July 1885 (about three months)",
   "source": "https://en.wikipedia.org/wiki/Ivan_the_Terrible_and_His_Son_Ivan ; https://www.kommersant.ru/doc/7381400 ; https://www.rbth.com/arts/330317-ivan-terrible-and-his-son-painting"
  },
  {
   "claim": "16 January 1913 (Old Style): Abram Balashov, a 29-year-old icon painter, slashed it three times with a knife, across the faces of father and son",
   "source": "https://en.wikipedia.org/wiki/Ivan_the_Terrible_and_His_Son_Ivan ; https://www.rbth.com/arts/330317-ivan-terrible-and-his-son-painting ; https://www.thecollector.com/repin-ivan-terrible-real-story-famous-work/"
  },
  {
   "claim": "He was reported to shout 'Enough blood!' (variants: 'Enough deaths, enough blood!', 'Stop the bloodshed!'); declared mentally ill and sent to an asylum",
   "source": "https://www.kommersant.ru/doc/7381400 ; https://www.tretyakovgallerymagazine.com/node/8318 ; https://en.wikipedia.org/wiki/Ivan_the_Terrible_and_His_Son_Ivan"
  },
  {
   "claim": "The gallery's keeper (curator) Khruslov reportedly threw himself under a train after the attack",
   "source": "https://en.wikipedia.org/wiki/Ivan_the_Terrible_and_His_Son_Ivan ; https://www.rbth.com/arts/330317-ivan-terrible-and-his-son-painting ; https://ru.wikipedia.org/wiki/Иван_Грозный_и_сын_его_Иван_16_ноября_1581_года"
  },
  {
   "claim": "Repin, aged 68, came to Moscow and repainted the damaged faces (restoration led by Igor Grabar and Dmitry Bogoslovsky)",
   "source": "https://www.rbth.com/arts/330317-ivan-terrible-and-his-son-painting ; https://www.kommersant.ru/doc/7381400 ; https://www.sobaka.ru/entertainment/art/96786"
  },
  {
   "claim": "25 May 2018: Igor Podporin smashed the glass with a metal stanchion and ripped the canvas in three places; he was quoted saying 'Ivan the Terrible did not kill his son'",
   "source": "https://themoscowtimes.com/news/attack-on-repin-painting-in-tretyakov-gallery-61591 ; https://www.rferl.org/a/russian-sentenced-to-2-1-2-years-for-vandalizing-iconic-painting-of-ivan-the-terrible/29912342.html"
  },
  {
   "claim": "After restoration it returned to permanent display on 16 December 2024 in an anti-vandal, bulletproof capsule, State Tretyakov Gallery, Moscow",
   "source": "https://www.themoscowtimes.com/2024/12/16/repin-painting-returns-to-moscows-tretyakov-gallery-nearly-7-years-after-vandal-attack-a87343 ; https://www.theartnewspaper.com/2022/05/27/russias-famous-ivan-the-terrible-painting-finally-restored-after-2018-attack"
  }
 ],
 "caption": "This painting has been attacked twice.\n\nIlya Repin finished Ivan the Terrible and His Son Ivan in 1885: the tsar clutching the son he has just struck in a rage (most accounts say with his staff; historians still argue). Tsar Alexander III had it banned from exhibition for about three months.\n\nIn January 1913, Abram Balashov, a 29-year-old icon painter, slashed it three times with a knife, straight through the faces. Witnesses reported he shouted \"Enough blood!\". He was declared insane and sent to an asylum. The gallery's keeper reportedly threw himself under a train. Repin, then 68, came to Moscow to repaint the faces.\n\nIn May 2018 a man smashed the glass with a metal pole and tore the canvas in three places, saying Ivan never killed his son. After years of restoration it went back on display in December 2024, inside a bulletproof case.\n\n🖤 Can a painting be too violent to show?",
 "caption_short": "Attacked with a knife in 1913, smashed with a metal pole in 2018. Repin's Ivan the Terrible now hangs behind bulletproof glass. 🖤",
 "youtube_title": "Who took a knife to it? Repin's Ivan the Terrible and His Son",
