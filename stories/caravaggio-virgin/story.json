 "facts": [
  {
   "claim": "Commissioned by the papal lawyer Laerzio Cherubini for his chapel in the Carmelite church of Santa Maria della Scala in Trastevere, Rome; it could not have been finished before 1605–06 (dates given c. 1601–1606)",
   "source": "https://en.wikipedia.org/wiki/Death_of_the_Virgin_(Caravaggio) ; https://www.open.edu/openlearn/history-the-arts/art-and-visual-culture-medieval-modern/content-section-2.3.2"
  },
  {
   "claim": "The painting shows the dead Virgin on a bed among mourners, without angels or heavenly glory; her body swollen, one hand hanging",
   "source": "https://en.wikipedia.org/wiki/Death_of_the_Virgin_(Caravaggio) ; https://collections.louvre.fr/en/recherche?q=caravage (INV 54)"
  },
  {
   "claim": "The church/Carmelites rejected it as unfit (lack of decorum); replaced by a painting by Carlo Saraceni",
   "source": "https://en.wikipedia.org/wiki/Death_of_the_Virgin_(Caravaggio) ; https://erenow.org/biographies/caravaggio-a-passionate-life/17.php ; https://www.aboutartonline.com/some-clarifications-regarding-article-by-c-renzi-on-the-death-of-the-virgin-and-on-the-way-of-using-models-by-caravaggio-original-text-in-english-with-italian-version/"
  },
  {
   "claim": "Giovanni Baglione, a painter and Caravaggio's rival (the 1603 libel suit), wrote in 1642 that Caravaggio made the Madonna 'swollen-up and with bare legs' (narration paraphrases, no quote marks)",
   "source": "https://en.wikipedia.org/wiki/Death_of_the_Virgin_(Caravaggio) (Baglione, Le Vite de' Pittori, 1642, p. 138) ; https://erenow.org/biographies/caravaggio-a-passionate-life/17.php ; https://en.wikipedia.org/wiki/Giovanni_Baglione"
  },
  {
   "claim": "Giulio Mancini, a physician and contemporary writer on art, claimed the model was a prostitute ('some dirty whore from the Ortaccio'); narration says 'claimed' — modern scholars call the model stories largely rumour",
   "source": "https://en.wikipedia.org/wiki/Death_of_the_Virgin_(Caravaggio) ; https://erenow.org/biographies/caravaggio-a-passionate-life/17.php ; https://en.wikipedia.org/wiki/Giulio_Mancini ; https://www.aboutartonline.com/some-clarifications-regarding-article-by-c-renzi-on-the-death-of-the-virgin-and-on-the-way-of-using-models-by-caravaggio-original-text-in-english-with-italian-version/"
  },
  {
   "claim": "Rubens (born 1577, then court painter to the Duke of Mantua) recommended it as one of Caravaggio's best works; Vincenzo Gonzaga, Duke of Mantua, bought it early in 1607",
   "source": "https://en.wikipedia.org/wiki/Death_of_the_Virgin_(Caravaggio) ; https://www.open.edu/openlearn/history-the-arts/art-and-visual-culture-medieval-modern/content-section-2.3.2 ; https://erenow.org/biographies/caravaggio-a-passionate-life/17.php"
  },
  {
   "claim": "Before leaving Rome it was exhibited for a week (1–7 April 1607, at the Mantuan ambassador Giovanni Magni's house on the Via del Corso); copying was absolutely forbidden",
   "source": "https://en.wikipedia.org/wiki/Death_of_the_Virgin_(Caravaggio) (Graham-Dixon 2011; Vodret & Granata 2012) ; https://erenow.org/biographies/caravaggio-a-passionate-life/17.php"
  },
  {
   "claim": "The Mantua collection was sold to Charles I of England in 1627; after his execution it was sold (1649), bought by Everhard Jabach, who sold it to Louis XIV in 1671",
   "source": "https://en.wikipedia.org/wiki/Death_of_the_Virgin_(Caravaggio) (Friedlaender 1955, pp. 195–197)"
  },
  {
   "claim": "Hangs in the Louvre, Paris (INV 54, Grande Galerie, Denon wing)",
   "source": "https://en.wikipedia.org/wiki/Death_of_the_Virgin_(Caravaggio) ; https://collections.louvre.fr/en/recherche?q=caravage"
  }
